import gleam/bit_array
import gleam/list
import gleam/string
import simplifile

pub fn code_files(to: String, files: List(String)) {
  let path = string.split(to, "/")
  let directory =
    path
    |> list.take(list.length(path) - 1)
    |> string.join("/")
  let assert Ok(_) = simplifile.create_directory_all(directory)
    as "cannot create directory for output"
  let assert Ok(_) = simplifile.write(to: to, contents: "")
    as "cannot write to output file"

  // write the header
  let assert Ok(_) =
    simplifile.write(
      to: to,
      contents: "// Generated automatically for use by kielet
// Do not edit this file directly, changes may be overwritten by the system
import gleam/bit_array
import kielet/database
import kielet/language

pub fn database() -> database.Database {
  let db = database.new()

",
    )
    as "cannot write to output file"

  list.map(files, fn(file) { code_file(to, file) })

  let assert Ok(_) =
    simplifile.append(
      to: to,
      contents: "
  db
}
",
    )
    as "cannot write to output file"

  Nil
}

pub fn code_file(to: String, file: String) {
  let assert Ok(contents) = simplifile.read_bits(file)
    as "cannot read input file"

  let contents = bit_array.base64_encode(contents, False)
  let assert Ok(basename) = string.split(file, "/") |> list.last
  let assert Ok(lang_id) = string.split(basename, ".") |> list.first
    as "language id is taken from filename, cannot find dot in filename"

  simplifile.append(to: to, contents: "

  // Load language from " <> basename <> " as base64 encoded MO data
  let assert Ok(mo_data) = bit_array.base64_decode(\"" <> contents <> "\")
  let assert Ok(lang) = language.load(\"" <> lang_id <> "\",mo_data)
  let db = db |> database.add_language(lang)
  ")
}
